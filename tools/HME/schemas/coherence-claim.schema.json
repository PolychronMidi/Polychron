{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polychron.local/hme/coherence-claim.schema.json",
  "title": "HME coherence claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "subject_uri",
    "producer",
    "producer_version",
    "status",
    "severity",
    "confidence",
    "evidence_uri",
    "evidence_hash",
    "scope",
    "invalidator_keys",
    "generated_at",
    "repair",
    "regression_tests",
    "retirement_condition"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "claim_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "subject_uri": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "producer_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "warn", "fail", "error", "stale", "unknown"] },
    "severity": { "enum": ["info", "warn", "blocker"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_uri": { "type": "string", "minLength": 1 },
    "evidence_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "invalidator_keys": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "repair": { "type": "string", "minLength": 1 },
    "regression_tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "retirement_condition": { "type": "string", "minLength": 1 },
    "supersedes": { "type": "array", "items": { "type": "string" }, "default": [] },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
