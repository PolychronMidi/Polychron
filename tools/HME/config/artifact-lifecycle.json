{
  "schema": 1,
  "classes": {
    "source": {
      "patterns": ["src/**", "tools/HME/**", "tools/csv_maestro/**", "tools/omniroute/**", "tools/update/**", "teams/rounds/**", "config/**", "*.js", "*.mjs", "*.json", "*.md", ".editorconfig", ".gitignore", ".env.sha256", "package.json", "package-lock.json", "tsconfig.json", "README.md", "plan.md"],
      "policy": "reviewed, tested, invariant-covered"
    },
    "config": {
      "patterns": ["tools/HME/config/**", "doc/templates/**", ".env.example", "doc/**"],
      "policy": "schema-checked or documented"
    },
    "fixture": {
      "patterns": ["tools/HME/tests/**", "test/**", "tests/**"],
      "policy": "explicit test fixture or spec"
    },
    "metric": {
      "patterns": ["src/output/metrics/**", "tools/HME/runtime/metrics/*.json", "tools/HME/runtime/metrics/*.jsonl"],
      "policy": "schema or freshness owner required when used as proof"
    },
    "runtime": {
      "patterns": ["tools/HME/runtime/**", "teams/runtime/**", "tmp/**", "log/**"],
      "policy": "not committed unless explicitly allowed as canonical runtime metric/proof"
    },
    "generated": {
      "patterns": ["package-lock.json", "dist/**", "build/**"],
      "policy": "reproducible from source or package manager"
    },
    "transcript": {
      "patterns": ["**/*.jsonl", "teams/runtime/output/**/round-progress.jsonl"],
      "policy": "append-only evidence; only canonical metrics/proof transcripts may be tracked"
    },
    "ephemeral": {
      "patterns": ["tmp/**", "*.tmp", "*.lock"],
      "policy": "never committed"
    },
    "proof": {
      "patterns": ["teams/runtime/output/**/_consult-*.json", "teams/runtime/output/**", "tools/HME/tests/fixtures/coherence-trace.sample.json", "log/todo/*.md"],
      "policy": "must link to verifier and causal path"
    },
    "migration-baseline": {
      "patterns": ["tools/HME/config/invariants/*baseline*.json"],
      "policy": "temporary; only shrinks"
    },
    "retired": {
      "patterns": ["**/*readq*retired*"],
      "policy": "must not be referenced outside explicit regression fixtures"
    }
  },
  "tracked_runtime_allowlist": [
    "tools/HME/runtime/metrics/hme-dir-intent.json",
    "tools/HME/runtime/metrics/hme-prediction-accuracy.json",
    "tools/HME/runtime/metrics/hme-suspected-upstreams.json",
    "tools/HME/runtime/INVENTORY.md",
    "teams/runtime/README.md"
  ]
}
